# Environment template for AI Job Market & Workforce Intelligence Platform.
# Copy this file to `.env` and replace placeholder values.
# Never commit a real `.env` file (it is gitignored).

# PostgreSQL connection
DATABASE_URL=postgresql://jobmarket:CHANGE_ME@localhost:5432/job_market_analytics

# Adzuna API (UK job data) — register at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Pipeline settings
PIPELINE_TEMP_DIR=D:\M Projects\AI-Powered Job Market & Workforce Intelligence Platform\data\processed
LOG_DIR=D:\M Projects\AI-Powered Job Market & Workforce Intelligence Platform\logs

# Data quality threshold (0-100) — records below this are quarantined
DQ_PASS_THRESHOLD=70

# Country targets for ingestion
PRIMARY_MARKET=gb
SECONDARY_MARKETS=pk
